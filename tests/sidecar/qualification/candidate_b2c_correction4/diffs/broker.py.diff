+    def register_unreleased_lease(self, lease, description=None):
+        """Independent-re-audit BLOCKER 2: durable, observable, broker-
+        owned fallback for a lease a command's OWN bounded retry budget
+        could not release. This is the terminal hand-off, never the
+        first attempt -- a command must exhaust its own retries first.
+        The lease remains a real, live, accounted-for object here (its
+        underlying view's `_active_leases` membership -- and therefore
+        the broker's ledger charge -- is untouched by this call; only
+        WHO is now responsible for eventually releasing it changes)."""
+        self._unreleased_lease_registry.append({
+            "lease": lease, "description": description, "registered_at": time.time(),
+            "reconcile_attempts": 0,
+        })
+        self._record("unreleased_lease_registered", {"description": description})
+
+    def unreleased_lease_count(self):
