+def parse_resource_shape_parts(header_bytes, directory_bytes, artifact_bytes):
+    """Independent-re-audit BLOCKER 1 fix -- THE preferred, allocation-
+    bounded preflight entry point. `header_bytes`: exactly the fixed
+    HEADER_SIZE bytes, read from file offset 0. `directory_bytes`:
+    exactly the directly-read directory-region bytes (i.e. what a caller
+    gets by `seek()`-ing straight to `header.section_directory_offset`
+    and reading `dir_region_end - section_directory_offset` bytes -- see
+    resource_preflight.py's own Stage 1) -- NEVER a sparse, offset-sized
+    buffer with the header and directory bytes placed at their absolute
+    file positions and everything in between left as unallocated/zero
+    padding. Memory used by this function is therefore proportional only
+    to `len(header_bytes) + len(directory_bytes)` (bounded: HEADER_SIZE +
+    up to `_MAX_PREFLIGHT_REGION_BYTES`), regardless of how large
+    `header.section_directory_offset` itself is -- a `seek()` offset
+    costs nothing to allocate for, only to move to.
+
+    Raises PreflightCorruptOrIncompatible for any malformed/inconsistent
+    header or directory. Never raises PreflightResourceRefusal itself --
+    that is the caller's job, after calling the estimator functions
+    below."""
+    if len(header_bytes) < fmt.HEADER_SIZE:
+        raise PreflightCorruptOrIncompatible("header buffer shorter than fixed header size")
+    header = fmt.unpack_header(header_bytes, 0)
+    normative_sizes = fmt.NORMATIVE_ROW_SIZES.get(header.format_contract_version)
+    dir_region_end = _validate_header_and_bound_directory_region(header, artifact_bytes)
+    dir_region_size = dir_region_end - header.section_directory_offset
+    if len(directory_bytes) < dir_region_size:
+        raise PreflightCorruptOrIncompatible(
+            "caller-supplied directory buffer does not contain the full declared directory region"
+        )
+    rows = _parse_directory_rows_local(header, directory_bytes, artifact_bytes, normative_sizes)
+    return _build_resource_shape(header, rows, artifact_bytes)
+
+
+def parse_resource_shape(buf_or_prefix, artifact_bytes):
+    """Compatibility entry point for callers that already hold one
+    REAL, CONTIGUOUS buffer whose byte 0 is the artifact's actual byte 0
+    (e.g. resource_preflight.py's Stage 3, which slices a prefix out of
+    the genuinely fully-read buffer -- never a reconstructed sparse
+    prefix). Internally slices out the directory-region sub-buffer at
+    its own true position within `buf_or_prefix` and delegates to the
+    SAME row-parsing logic `parse_resource_shape_parts` uses -- there is
+    only one directory-row-parsing implementation now, not two. Do NOT
+    use this entry point with a sparse/reconstructed buffer merely to
+    satisfy this signature -- use `parse_resource_shape_parts` directly
+    for any caller that only has the header and directory bytes
+    separately (the whole point of BLOCKER 1's fix)."""
+    buf = buf_or_prefix
+    if len(buf) < fmt.HEADER_SIZE:
+        raise PreflightCorruptOrIncompatible("buffer shorter than fixed header size")
+
+    header = fmt.unpack_header(buf, 0)
+    dir_region_end = _validate_header_and_bound_directory_region(header, artifact_bytes)
+    if dir_region_end > len(buf):
+        raise PreflightCorruptOrIncompatible(
+            "caller-supplied prefix buffer does not contain the full declared directory region"
+        )
+    directory_bytes = buf[header.section_directory_offset:dir_region_end]
+    return parse_resource_shape_parts(buf[:fmt.HEADER_SIZE], directory_bytes, artifact_bytes)
+
