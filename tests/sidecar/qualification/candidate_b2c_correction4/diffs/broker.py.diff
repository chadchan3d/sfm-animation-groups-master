+    def retry_unreleased_leases(self):
+        """Attempts to release every currently-registered unreleased
+        lease exactly once each; each success is removed from the
+        registry, each failure's `reconcile_attempts` is incremented and
+        it remains registered (bounded only by however many times a
+        caller chooses to invoke this -- this method itself never loops
+        internally, so it can never itself hang or spin). Returns
+        (succeeded_count, still_failing_count). Never relies on Python
+        object finalizers/GC -- this is the SOLE sanctioned path for a
+        broker-owned lease to ever actually be released."""
+        succeeded = 0
+        still_pending = []
+        for entry in self._unreleased_lease_registry:
+            try:
+                self._view_cache.release_lease(entry["lease"])
+                succeeded += 1
+                self._record("unreleased_lease_reconciled", {"description": entry["description"]})
+            except Exception as exc:
+                entry["reconcile_attempts"] += 1
+                self._record("unreleased_lease_reconcile_failed", {
+                    "description": entry["description"], "attempts": entry["reconcile_attempts"],
+                    "detail": str(exc),
+                })
+                still_pending.append(entry)
+        self._unreleased_lease_registry = still_pending
+        return succeeded, len(still_pending)
